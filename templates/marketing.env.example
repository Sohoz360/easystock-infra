# ── easystock-marketing (ezycore.com) build env ────────────────────────────────
# NOT a VPS service. The marketing site is a Next.js **static export**
# (`output: "export"` → ./out) served by Cloudflare Pages' CDN — there is no
# container, no compose entry and no `/opt/easystock/.env.marketing`.
#
# These are set in: Cloudflare Pages → project → Settings → Environment variables,
# for BOTH the Production and Preview environments. They are read AT BUILD TIME
# only; changing one requires a rebuild (Deploy hooks → Retry deployment).
#
# It lives here because this directory is the ecosystem's env registry — every var
# any tier reads should be findable in one place. Mirror of
# easystock-marketing/.env.example; keep the two identical.

# Cross-tier link targets, baked in at BUILD time (NEXT_PUBLIC_*).
# Production defaults are hardcoded in lib/site-config.ts; override per environment.
#   production →  https://app.ezycore.com   /  https://mc.ezycore.com
#   staging    →  https://rc.ezycore.com    /  https://rc-mc.ezycore.com
NEXT_PUBLIC_APP_URL=https://app.ezycore.com
NEXT_PUBLIC_MC_URL=https://mc.ezycore.com

# Mission Control API base — read at BUILD time to fetch public pricing. Server-side
# only (NOT NEXT_PUBLIC), so it needs no CORS. MC POSTs the Cloudflare Deploy Hook
# (MC's MARKETING_DEPLOY_HOOK_URL) when a PUBLIC plan changes, which re-runs this build.
#   production →  https://mc-api.ezycore.com
#   staging    →  https://rc-mc-api.ezycore.com
MC_API_URL=https://mc-api.ezycore.com

# Web3Forms access key for the Contact / "Request a demo" form (client-side POST,
# so it must be NEXT_PUBLIC). Get a free key at https://web3forms.com — the form
# degrades to an error state if this is unset. NOT a secret (public by design).
NEXT_PUBLIC_WEB3FORMS_KEY=


# Google Analytics 4 Measurement ID (G-XXXXXXXXXX), from Admin → Data streams →
# your web stream. NEXT_PUBLIC because gtag.js runs in the browser. NOT a secret —
# it ships in the HTML of every page.
#
# UNSET = no analytics at all: components/analytics.tsx renders null. Set it on the
# Cloudflare **Production** environment ONLY — leaving Preview unset keeps branch
# deploys and local dev out of the real property.
#
# Adding this made the privacy policy's "we use no analytics cookies" claim false;
# lib/i18n/dictionaries/{en,bn}.ts were updated in the same change. If GA is ever
# removed, that copy has to go back.
NEXT_PUBLIC_GA_ID=
