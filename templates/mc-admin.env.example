# ── mission-control-admin runtime env ──────────────────────────────────────────
# Like the frontend, the admin's API URL (NEXT_PUBLIC_API_URL) is baked at BUILD TIME
# (§8.4), so the running container reads nothing at runtime. This file exists only for
# compose's `env_file: ./.env.mc-admin`. Copy to /opt/easystock/{production,staging}/.env.mc-admin.
NODE_ENV=production

# ── BUILD-TIME var (NOT read here — listed so this stays the env registry) ─────
# Set as a `build-arg` in mission-control/.github/workflows/deploy.yml, declared as
# ARG/ENV in admin/Dockerfile. Changing it requires a REBUILD + redeploy.
#
#   NEXT_PUBLIC_API_URL
#     MC API base, including /api. Per environment:
#       production →  https://mc-api.ezycore.com/api
#       staging    →  https://rc-mc-api.ezycore.com/api
#     Supplied from the repo secrets NEXT_PUBLIC_MC_API_URL_PROD / _STAGING.
